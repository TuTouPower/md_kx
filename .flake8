[flake8]
max-line-length = 88
max-complexity = 10
extend-ignore =
    # E203: Whitespace before ':' (violates PEP8 and black style)
    E203,
    # A005: A module is shadowing a Python builtin module
    A005,
extend-exclude =
    */site-packages/*
per-file-ignores =
    # 模板工具链、测试与 hook：模板代码风格非业务，sync 强制覆盖不回改
    .repo_template/scripts/*:E402,E501,E302,E305,E303,C901,C420,F401,B014,B007,F541
    .repo_template/tests/*:E402,E501,E302,E305,E303,C901,C420,F401,B014,B007,F841
